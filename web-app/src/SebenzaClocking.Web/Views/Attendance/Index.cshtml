@model AttendanceListViewModel
@{ ViewData["Title"] = "Attendance Records"; }
<form method="get" class="filters">
  <label>Date <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" /></label>
  <label>Department <select name="departmentId" asp-items="Model.Departments"></select></label>
  <button class="btn" type="submit">Filter</button>
  <a class="btn ghost" asp-action="Export" asp-route-date="@Model.Date">Export CSV</a>
</form>
<div class="panel">
<table class="tbl">
  <thead><tr><th>Date</th><th>Employee</th><th>Department</th><th>In</th><th>Out</th><th>Break</th><th>Total</th><th>OT</th><th>Status</th></tr></thead>
  <tbody>
  @foreach (var r in Model.Records)
  {
    <tr>
      <td>@Sast.Date(r.ClockIn)</td>
      <td><a asp-action="Detail" asp-route-id="@r.Id">@r.EmployeeName</a></td>
      <td>@r.DepartmentName</td>
      <td class="@(r.IsLate ? "late" : "")">@Sast.HHmm(r.ClockIn)</td>
      <td>@(r.ClockOut is null ? "—" : Sast.HHmm(r.ClockOut.Value))</td>
      <td>@r.BreakMinutes min</td>
      <td>@(r.TotalHours is null ? "—" : TimeCalculations.FormatHours(r.TotalHours.Value))</td>
      <td>@r.OvertimeHours.ToString("0.00")h</td>
      <td><span class="tag">@r.Status</span></td>
    </tr>
  }
  @if (!Model.Records.Any()) { <tr><td colspan="9" class="empty">No attendance records for this date and filters.</td></tr> }
  </tbody>
</table>
</div>
